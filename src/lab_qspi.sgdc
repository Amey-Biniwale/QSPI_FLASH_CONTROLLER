current_design "QSPI_top"


clock -name PCLK -domain d1 -period 10 -tag CLOCK_DOMAIN_1 -edge {0 5}
clock -name HCLK -domain d2 -period 10 -tag CLOCK_DOMAIN_2 -edge {0 5}
clock -name SCLK -domain d3 -period 20 -tag CLOCK_DOMAIN_3 -edge {0 10}

reset -name PRESETn -value 0
reset -name HRESETn -value 0
reset -name SRESETn -value 0


input -name PWRITE -clock PCLK
input -name PENABLE -clock PCLK
input -name PWDATA -clock PCLK
input -name PSEL -clock PCLK
input -name PSTRB -clock PCLK
input -name PADDR -clock PCLK

input -name HSEL -clock HCLK
input -name HADDR -clock HCLK
input -name HWRITE -clock HCLK
input -name HTRANS -clock HCLK

input -name FLASH_WIP -clock SCLK
input -name io0_i -clock SCLK
input -name io1_i -clock SCLK
input -name io2_i -clock SCLK
input -name io3_i -clock SCLK

output -name PSLVERR -clock PCLK
output -name PREADY -clock PCLK
output -name PRDATA -clock PCLK

output -name HRDATA -clock HCLK
output -name HREADYOUT -clock HCLK
output -name HRESP -clock HCLK

output -name CSn -clock SCLK
output -name io0_o -clock SCLK
output -name io1_o -clock SCLK
output -name io2_o -clock SCLK
output -name io3_o -clock SCLK
output -name io0_oe -clock SCLK
output -name io1_oe -clock SCLK
output -name io2_oe -clock SCLK
output -name io3_oe -clock SCLK

num_flops -reset -to_domain d3 -value 4
num_flops -reset -to_domain d2 -value 4
num_flops -reset -to_domain d1 -value 4


