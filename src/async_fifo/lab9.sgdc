current_design "over_top"


clock -name clk1 -domain d1 -period 10 -tag CLOCK_DOMAIN_1 -edge {0 5}
clock -name clk2 -domain d2 -period 15 -tag CLOCK_DOMAIN_2 -edge {0 7.5}

reset -name rst1 -value 1
reset -name rst2 -value 1


input -name d1 -clock clk1
input -name w_en -clock clk1
input -name r_en -clock clk2

output -name d2 -clock clk2
output -name full -clock clk1
output -name empty -clock clk2

num_flops -reset -to_domain d2 -value 4
num_flops -reset -to_domain d1 -value 4


