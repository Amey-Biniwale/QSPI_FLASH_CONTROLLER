verification_cycle
over_top.s2
wf_signal_group -name "Destination Output" -signals {over_top.s2}
over_top.t1.f1.rtlc_N5
wf_signal_group -name "Destination Input" -signals {over_top.t1.f1.rtlc_N5}
over_top.t1.f1.rtlc_N1
wf_signal_group -name "Destination Input" -signals {over_top.t1.f1.rtlc_N1}
over_top.clk2
wf_signal_group -name "Destination Clock" -signals {over_top.clk2}
over_top.clk1
wf_signal_group -name "Source Clock" -signals {over_top.clk1}
\over_top.t1.f1.mem[15]\
wf_signal_group -name "Source Output" -signals {over_top.t1.f1.mem[15]}
